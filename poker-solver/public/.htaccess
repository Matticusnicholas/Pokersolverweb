DirectoryIndex index.html

RewriteEngine On

# Force HTTPS (optional - uncomment if you have SSL)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# If the request is for a real file or directory, serve it
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# For any route, try to serve the corresponding index.html
RewriteRule ^equity/?$ /equity/index.html [L]
RewriteRule ^preflop/?$ /preflop/index.html [L]

# Fallback to root index.html
RewriteRule ^ /index.html [L]

# Prevent directory listing
Options -Indexes

# Set proper MIME types
AddType application/javascript .js
AddType text/css .css
AddType application/json .json
AddType image/svg+xml .svg
